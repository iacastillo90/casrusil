# ==============================================================
# .env.example — Plantilla de variables de entorno para SII-ERP
# ==============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA pongas secretos reales en este archivo (.env.example SÍ se versiona).
# En producción, inyecta estos valores desde un gestor de secretos
# (AWS Secrets Manager / SSM / HashiCorp Vault), no desde un .env en disco.
# ==============================================================

# --- PostgreSQL / PgVector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CAMBIAR__
POSTGRES_DB=sii_erp_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=__CAMBIAR__

# --- Spring Boot ---
# Valores: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# --- JWT Security ---
# Generar con: openssl rand -hex 64
JWT_SECRET=__GENERAR_CON_openssl_rand_hex_64__
# Recomendado <= 1h para access token; usar refresh tokens para sesiones largas.
JWT_EXPIRATION=3600000

# --- Certificado SII ---
# En producción: ruta EXTERNA al .p12 real (NO usar classpath ni versionarlo)
SII_CERTIFICATE_PATH=file:/ruta/segura/certificado.p12
SII_CERTIFICATE_PASSWORD=__CAMBIAR__

# --- IA (usar SOLO desde el backend; el frontend no debe portar claves) ---
OPENAI_API_KEY=__CAMBIAR__
GEMINI_API_KEY=__CAMBIAR__
GEMINI_MODEL_NAME=gemini-2.5-flash
XAI_API_KEY=__CAMBIAR__
PGVECTOR_DIMENSION=1536

# --- Frontend / CORS ---
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@dominio.com
# App Password del proveedor de correo (NO una API key)
MAIL_PASSWORD=__APP_PASSWORD_DE_CORREO__

# --- Observabilidad ---
TRACING_SAMPLING_PROBABILITY=0.1
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces

# --- Resiliencia / Chaos (deshabilitado por defecto) ---
CHAOS_MONKEY_ENABLED=false
