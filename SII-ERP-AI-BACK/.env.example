# ==============================================================
# .env.example (Backend) — Plantilla de variables de entorno
# Copia a `.env` y rellena valores reales. NO versionar el `.env`.
# ==============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CAMBIAR__
POSTGRES_DB=sii_erp_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- IA (clave server-side; nunca compartir con el frontend) ---
GEMINI_API_KEY=__CAMBIAR__
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENAI_API_KEY=__CAMBIAR__

# --- PgVector ---
PGVECTOR_DIMENSION=384

# --- Resilience4j ---
RESILIENCE4J_SLIDING_WINDOW_SIZE=10
RESILIENCE4J_MINIMUM_NUMBER_OF_CALLS=5
RESILIENCE4J_PERMITTED_NUMBER_OF_CALLS_IN_HALF_OPEN_STATE=3
RESILIENCE4J_WAIT_DURATION_IN_OPEN_STATE=5s
RESILIENCE4J_FAILURE_RATE_THRESHOLD=50

# --- Observability ---
OTLP_TRACING_ENDPOINT=http://localhost:4317
TRACING_SAMPLING_PROBABILITY=1.0

# --- Chaos Monkey (SOLO para pruebas de resiliencia; false por defecto) ---
CHAOS_MONKEY_ENABLED=false

# --- Mail ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@dominio.com
# App Password del proveedor (NO una API key de Google)
MAIL_PASSWORD=__APP_PASSWORD_DE_CORREO__

# --- JWT ---
JWT_SECRET=__GENERAR_CON_openssl_rand_hex_64__
JWT_EXPIRATION=3600000

# --- Certificado SII (ruta externa en prod) ---
SII_CERTIFICATE_PATH=file:/ruta/segura/certificado.p12
SII_CERTIFICATE_PASSWORD=__CAMBIAR__
