# ==============================================================
# .env.example (Frontend) — Plantilla de variables de entorno
# Copia a `.env.local` y rellena valores reales. NO versionar el `.env`.
# ==============================================================

# URL del backend (RELATIVA para usar el proxy same-origin de next.config.mjs).
# Mantenerla relativa (/api/v1) es lo que permite que la cookie httpOnly del
# backend se almacene y reenvíe bajo el mismo origen del frontend.
NEXT_PUBLIC_API_URL=/api/v1

# URL interna del backend a la que el proxy reenvía (solo servidor, no expuesta al navegador).
BACKEND_INTERNAL_URL=http://localhost:8080

# --- IA ---
# RECOMENDADO: NO poner claves de IA en el frontend. Las llamadas a Gemini/OpenAI
# deben hacerse a través del backend para no exponer la clave al cliente.
# Si (temporalmente) se usa server-side en Next, mantener SIN prefijo NEXT_PUBLIC_:
GOOGLE_GENERATIVE_AI_API_KEY=__CAMBIAR__
GOOGLE_GENERATIVE_AI_MODEL=models/gemini-2.5-flash
